{
  "name": "benchtop",
  "productName": "Benchtop",
  "version": "1.0.0",
  "description": "Browse your maker projects \u2014 code, PCB, 3D and docs \u2014 in one place",
  "main": ".vite/build/main.js",
  "author": "Loic Daigle",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run build:easyeda && electron-forge package",
    "make": "npm run build:easyeda && electron-forge make",
    "typecheck": "tsc --noEmit && tsc --noEmit -p easyeda-extension/tsconfig.json",
    "test": "tsx --test src/main/scanner.test.ts src/main/structure.test.ts src/main/easyeda.test.ts src/main/bridge.test.ts src/main/outline.test.ts src/main/releases.test.ts src/main/gerber.test.ts",
    "draft-info": "tsx scripts/draft-project-info.ts",
    "build:easyeda": "node scripts/build-easyeda-extension.mjs",
    "publish": "npm run build:easyeda && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@jlceda/pro-api-types": "^0.4.27",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.11.1",
    "occt-import-js": "^0.0.23",
    "pcb-stackup": "^4.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "update-electron-app": "^3.3.0",
    "whats-that-gerber": "^4.2.7",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loic-daigle/benchtop.git"
  }
}
